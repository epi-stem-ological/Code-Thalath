<%- include('partials/header') %>

<div class="module">
  <div class="modhead"><span><%= b.subject %></span><a href="/bulletins">&laquo; Bulletin Board</a></div>
  <div class="body">
    <div class="row" style="border:0;padding:0">
      <a href="/u/<%= b.username %>"><img class="thumb" src="<%= u.avatarUrl(b) %>" alt=""></a>
      <div>
        <a href="/u/<%= b.username %>" class="nametext"><%= b.display_name %></a>
        <div class="dim"><%= u.fmtDateTime(b.created_at) %></div>
      </div>
    </div>
    <hr>
    <div class="ugc"><%- b.body %></div>
  </div>
  <div class="body" style="border-top:1px solid #ccc">
    <a class="btn" href="/mail/compose?to=<%= b.username %>&amp;subject=RE: <%= encodeURIComponent(b.subject) %>">Reply by mail</a>
    <a class="btn" href="/bulletins/compose">Post your own</a>
    <% if (b.author_id === me.id || me.is_admin) { %>
      <form method="post" action="/bulletins/<%= b.id %>/delete" style="display:inline" data-confirm="Delete this bulletin?">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn small danger">Delete</button>
      </form>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
