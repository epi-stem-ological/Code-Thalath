<%- include('partials/header') %>
<meta name="csrf" content="<%= csrf %>">

<div class="ms-cols">
  <div class="ms-col-right">

    <% if (error) { %><div class="ms-flash err"><%= error %></div><% } %>

    <div class="module">
      <div class="modhead">Notifications on this device</div>
      <div class="body">
        <p id="push-status">
          <% if (pushCount) { %>
            Push is set up on <b><%= pushCount %></b> device(s) for this account.
          <% } else { %>
            Push notifications are off.
          <% } %>
        </p>
        <p>
          <button class="btn primary" onclick="enablePush()">Turn on notifications here</button>
          <button class="btn" id="install-btn" style="display:none">Install app</button>
        </p>
        <form method="post" action="/push/test" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn small">Send me a test notification</button>
        </form>
        <p class="hint">
          <b>iPhone:</b> notifications only work after you add the site to your Home Screen and open it from there
          (Safari &rarr; Share &rarr; Add to Home Screen). <b>Android:</b> works in Chrome either way.
        </p>
      </div>
    </div>

    <div class="module">
      <div class="modhead">Username</div>
      <div class="body">
        <form method="post" action="/settings/username">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label for="username">Your URL is /u/<%= me.username %></label>
          <input type="text" id="username" name="username" value="<%= me.username %>" style="width:100%">
          <div class="hint">Changing this breaks any old links to your profile.</div>
          <button class="btn mt6">Change username</button>
        </form>
      </div>
    </div>

    <div class="module">
      <div class="modhead">Password</div>
      <div class="body">
        <form method="post" action="/settings/password">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field"><label for="current">Current password</label>
            <input type="password" id="current" name="current" autocomplete="current-password" required style="width:100%"></div>
          <div class="field"><label for="next">New password</label>
            <input type="password" id="next" name="next" autocomplete="new-password" required style="width:100%"></div>
          <div class="field"><label for="confirm">Confirm new password</label>
            <input type="password" id="confirm" name="confirm" autocomplete="new-password" required style="width:100%"></div>
          <button class="btn primary">Change password</button>
        </form>
      </div>
    </div>

    <div class="module">
      <div class="modhead">Signed-in devices (<%= sessions.length %>)</div>
      <div class="body tight">
        <table class="grid">
          <% sessions.forEach(function (s) { %>
            <tr>
              <td><%= s.user_agent ? s.user_agent.slice(0, 70) : 'unknown device' %><% if (s.id === undefined) { %><% } %></td>
              <td class="right dim nowrap"><%= u.timeAgo(s.created_at) %></td>
            </tr>
          <% }); %>
        </table>
        <div class="body">
          <form method="post" action="/settings/sessions/revoke" data-confirm="Sign out all your other devices?">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn small">Sign out everywhere else</button>
          </form>
        </div>
      </div>
    </div>

    <div class="module">
      <div class="modhead" style="background:#cc0000">Delete my account</div>
      <div class="body">
        <p class="dim">This wipes your profile, comments, blogs, photos and messages. It cannot be undone.</p>
        <form method="post" action="/settings/delete" data-confirm="Really delete your account forever?">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="password" name="password" placeholder="your password" required>
          <button class="btn danger">Delete forever</button>
        </form>
      </div>
    </div>
  </div>

  <div class="ms-col-left">
    <div class="module">
      <div class="modhead">Quick links</div>
      <div class="body">
        <p><a href="/edit">Edit profile</a></p>
        <p><a href="/edit/design">Change layout &amp; wallpaper</a></p>
        <p><a href="/edit/song">Change profile song</a></p>
        <p><a href="/edit/top">Change my Top friends</a></p>
        <p><a href="/viewers">Who viewed me</a></p>
        <p><a href="/help">Help</a></p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
