# Everything here is optional — the app boots with no config at all.

# PORT=3000
# HOST=0.0.0.0

# Shown in the header and the PWA name (also editable later at /admin)
# SITE_NAME=Thalath Space

# First-run only: the Tom account. Leave TOM_PASSWORD unset to get a random
# one printed to the console once.
# TOM_USERNAME=tom
# TOM_PASSWORD=
# TOM_DISPLAY_NAME=Tom

# Where state lives. Back both of these up.
# DATA_DIR=./data
# UPLOAD_DIR=./uploads

# Upload limits, in megabytes
# MAX_IMAGE_MB=12
# MAX_AUDIO_MB=25

# Set to 1 once you are serving over HTTPS
# SECURE_COOKIES=1
# TRUST_PROXY=1

# Push keys generate themselves on first boot and persist in the database.
# Only set these if you need to move an existing install's subscriptions.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# NODE_ENV=production
